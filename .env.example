# Modelo de variáveis de ambiente da API (copiar para .env e preencher; o .env real nunca vai para o Git).
# Aqui ficam só os nomes, sem valores. Em produção os valores ficam nas configurações da Function App.

# Conexão do Cosmos DB. Para o docker compose (emulador do Cosmos DB), usar a connection string do
# emulador, com a chave pública dele: é a mesma linha que o workflow .github/workflows/compose-zap.yml
# grava no .env do CI. Para um Cosmos real, a connection string dele.
COSMOS_CONNECTION=
# Nome do banco e do container das leituras (no projeto: coldtrack e leituras).
COSMOS_DATABASE=
COSMOS_CONTAINER=
# Segredo que assina os tokens: aleatório, com 32 bytes ou mais.
JWT_SECRET=

# Código de missão (6 caracteres do professor). Só aqui e na app setting da Function App,
# nunca no código. Vazio: os logs de bloqueio saem com [SEM-CODIGO].
MISSAO_CODIGO=

# Azure OpenAI (assistente): endpoint do recurso (https://<recurso>.openai.azure.com/), nomes dos
# deployments de chat e de embeddings e versão da API (os usados no CI estão em compose-zap.yml).
AOAI_ENDPOINT=
AOAI_DEPLOY_CHAT=
AOAI_DEPLOY_EMBED=
AOAI_API_VERSION=
