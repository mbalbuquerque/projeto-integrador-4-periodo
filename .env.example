# Modelo de variáveis de ambiente da API (copiar para .env; o .env real nunca vai para o Git).
# Em produção estes valores ficam nas configurações da Function App, não em arquivo.

# Valores de desenvolvimento para o docker compose (emulador do Cosmos DB, chave pública do emulador).
# Para apontar para um Cosmos real, trocar pela connection string dele.
COSMOS_CONNECTION=AccountEndpoint=http://cosmos:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==;
COSMOS_DATABASE=coldtrack
COSMOS_CONTAINER=leituras
JWT_SECRET=<segredo aleatório com 32 bytes ou mais>

