# Modelo de variáveis de ambiente da API (copiar para .env; o .env real nunca vai para o Git).
# Em produção estes valores ficam nas configurações da Function App, não em arquivo.

COSMOS_CONNECTION=<connection string do Cosmos DB de desenvolvimento>
COSMOS_DATABASE=coldtrack
COSMOS_CONTAINER=leituras
JWT_SECRET=<segredo aleatório com 32 bytes ou mais>

AOAI_ENDPOINT=https://<recurso>.openai.azure.com/
AOAI_DEPLOY_CHAT=gpt-4.1-mini
AOAI_DEPLOY_EMBED=text-embedding-3-small
AOAI_API_VERSION=2024-10-21
